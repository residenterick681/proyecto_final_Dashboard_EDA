            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Crudo observado (bbl)",
            "expression": "SUM(Produccion[Crudo_bbl])",
            "formatString": "#,0.00",
            "displayFolder": "Produccion",
            "description": "Suma del volumen disponible. Los faltantes no se sustituyen por cero.",
            "lineageTag": "a06a16c8-ca0b-5de2-a4b4-9421e7970fda"
          },
          {
            "name": "Gas observado (miles pies3)",
            "expression": "SUM(Produccion[Gas_miles_pies3])",
            "formatString": "#,0.00",
            "displayFolder": "Produccion",
            "description": "Unidad adoptada del diccionario del proyecto; no es crudo equivalente.",
            "lineageTag": "8463a94f-add5-50bc-a988-7559b2312c7e"
          },
          {
            "name": "N registros",
            "expression": "COUNTROWS(Produccion)",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Filas unicas activo-mes en el contexto filtrado.",
            "lineageTag": "eb0eb9bd-5b67-5768-b5c3-81d0af09148f"
          },
          {
            "name": "N crudo",
            "expression": "COUNT(Produccion[Crudo_bbl])",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Numero de observaciones mensuales no vacias de crudo; por activo equivale al n del grupo.",
            "lineageTag": "c19cdae4-6388-5174-a70b-510e3e6cc9ab"
          },
          {
            "name": "N gas",
            "expression": "COUNT(Produccion[Gas_miles_pies3])",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Numero de observaciones mensuales no vacias de gas.",
            "lineageTag": "4cfc2ab7-cf27-5cc4-bcec-2bd29274b5f7"
          },
          {
            "name": "Dias del periodo productivo",
            "expression": "CALCULATE(SUM(Calendario[Dias_mes]), KEEPFILTERS(Calendario[Con_produccion] = 1))",
            "formatString": "#,0",
            "displayFolder": "Produccion",
            "description": "Dias de los meses seleccionados dentro de enero 2022-agosto 2026, contados una sola vez. Un activo con cobertura incompleta conserva el denominador del periodo.",
            "lineageTag": "2cb9e75d-dd09-5897-a998-26ec490307f8"
          },
          {
            "name": "Aporte diario observado (bbl)",
            "expression": "DIVIDE([Crudo observado (bbl)], [Dias del periodo productivo])",
            "formatString": "#,0.00",
            "displayFolder": "Produccion",
            "description": "Volumen observado / dias del periodo. No es la media simple de las tasas ni un ajuste de faltantes; revisar n y cobertura al comparar activos.",
            "lineageTag": "23ed53db-48a8-57b2-beee-9d2dbba05dbf"
          },
          {
            "name": "Precio promedio (USD/bbl)",
            "expression": "AVERAGE(Precios[Precio_USD_bbl])",
            "formatString": "$#,0.00",
            "displayFolder": "Precios",
            "description": "Media simple entre meses con precio; no se repite por activo, no se pondera por produccion y no equivale a ingresos.",
            "lineageTag": "8138fdc4-336b-57f7-88e3-de53dee3d5c3"
          },
          {
            "name": "N meses con precio",
            "expression": "COUNT(Precios[Precio_USD_bbl])",
            "formatString": "#,0",
            "displayFolder": "Precios",
            "description": "Numero de precios mensuales validos en el periodo.",
            "lineageTag": "319f6f20-38c6-5cc2-9766-77675d76be92"
          },
          {
            "name": "Meses productivos sin precio",
            "expression": "CALCULATE(COUNTROWS(Calendario), KEEPFILTERS(Calendario[Con_produccion] = 1), KEEPFILTERS(Calendario[Con_precio] = 0))",
            "formatString": "#,0",
            "displayFolder": "Precios",
            "description": "Meses de la ventana productiva sin precio: agosto de 2026 en la fuente disponible.",
            "lineageTag": "eba57009-ccac-5326-9880-e011da345ddc"
          },
          {
            "name": "Activos observados",
            "expression": "DISTINCTCOUNT(Produccion[Activo])",
            "formatString": "#,0",
            "displayFolder": "Produccion",
            "description": "Activos con al menos un registro dentro de la seleccion.",
            "lineageTag": "b402fde6-6372-5e9b-a8a8-720f6e395216"
          },
          {
            "name": "Conflictos crudo",
            "expression": "SUM(Produccion[Conflicto_crudo])",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Celdas de crudo anuladas por valores discrepantes de una misma clave.",
            "lineageTag": "e91ee3f8-4f3b-598b-9001-43da009d845f"
          },
          {
            "name": "Conflictos gas",
            "expression": "SUM(Produccion[Conflicto_gas])",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Celdas de gas anuladas por valores discrepantes de una misma clave.",
            "lineageTag": "81344162-8107-5793-81e7-22a83977badf"
          },
          {
            "name": "Conflictos totales",
            "expression": "[Conflictos crudo] + [Conflictos gas]",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Cuenta de celdas conflictivas, no de filas duplicadas.",
            "lineageTag": "5f2f93eb-dd4d-57fc-9dd5-35914dc9ab79"
          },
          {
            "name": "Atipicos crudo",
            "expression": "SUM(Produccion[Atipico_crudo])",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Banderas IQR calculadas previamente dentro de cada activo. Se conservan los registros.",
            "lineageTag": "52539a7f-89df-5151-bcea-3f8e1fa3a2b9"
          },
          {
            "name": "Atipicos gas",
            "expression": "SUM(Produccion[Atipico_gas])",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Banderas IQR del gas diario dentro de cada activo; el filtro no recalcula los limites historicos.",
            "lineageTag": "ffd1a273-505c-506a-b774-84c7a77d398c"
          },
          {
            "name": "Huecos internos",
            "expression": "CALCULATE(COUNTROWS(Cobertura), KEEPFILTERS(Cobertura[Estado] = \"sin registro interior\"))",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Meses ausentes entre el primer y ultimo registro de cada activo; no son volumen cero.",
            "lineageTag": "b5421cb0-7cd2-5ba0-a188-e98f8dff9e9e"
          },
          {
            "name": "Estado del grupo",
            "expression": "VAR N = [N crudo] RETURN IF(ISBLANK(N) || N = 0, \"Sin crudo valido\", IF(N < 12, \"PRECAUCION: n < 12\", \"n >= 12; revisar cobertura\"))",
            "formatString": "",
            "displayFolder": "Calidad",
            "description": "Umbral descriptivo de doce meses para advertir series cortas; no garantiza independencia ni suficiencia estadistica.",
            "lineageTag": "fa15dc43-350f-57f5-948f-a91cdb3dc9cb"
          },
          {
            "name": "Grupos pequenos",
            "expression": "SUMX(VALUES(Activos[Activo]), VAR N = CALCULATE([N crudo]) RETURN IF(N > 0 && N < 12, 1, 0))",
            "formatString": "#,0",
            "displayFolder": "Calidad",
            "description": "Numero de activos seleccionados con entre uno y once meses validos de crudo.",
            "lineageTag": "64c5234a-7477-516b-8d32-80bc9e1aa3b4"
          },
          {
            "name": "Advertencia de grupos",
            "expression": "VAR G = [Grupos pequenos] RETURN IF(ISBLANK([N crudo]) || [N crudo] = 0, \"Sin datos de crudo en esta seleccion\", IF(G > 0, FORMAT(G, \"0\") & \" grupo(s) con n < 12. Interpretar con cautela.\", \"Revisar cobertura, faltantes y cambios de composicion.\"))",
            "formatString": "",
            "displayFolder": "Calidad",
            "description": "Advertencia dinamica segun filtros. Observaciones mensuales, no muestras independientes.",
            "lineageTag": "dd9fffdd-3c08-5267-9258-e477cbf86b96"
          },
          {
            "name": "Participacion crudo",
            "expression": "DIVIDE([Crudo observado (bbl)], CALCULATE([Crudo observado (bbl)], ALLSELECTED(Activos)))",
            "formatString": "0.0%",
            "displayFolder": "Produccion",
            "description": "Fraccion del crudo observado entre los activos seleccionados, manteniendo el periodo.",
            "lineageTag": "d522a674-e171-525c-8f4f-8d753fc6195d"
          }
        ]
      },

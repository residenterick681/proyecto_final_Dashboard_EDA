let
    Fuente = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),
    Nulos = Table.ReplaceValue(Encabezados, "", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),
    Tipos = Table.TransformColumnTypes(Nulos, {{"Mes", type date}, {"Activo", type text}, {"Crudo_bbl", type number}, {"Gas_miles_pies3", type number}, {"Crudo_diario_bbl", type number}, {"Gas_diario_miles_pies3", type number}, {"Conflicto_crudo", Int64.Type}, {"Conflicto_gas", Int64.Type}, {"Atipico_crudo", Int64.Type}, {"Atipico_gas", Int64.Type}, {"Filas_origen", Int64.Type}, {"Referencias_origen", type text}}, "en-US")
in
    Tipos
